# PC 用。コピーして .env.local を作成し、プロファイルを設定する。
AWS_PROFILE=your-profile
AWS_REGION=ap-northeast-1
CLOUDOPS_CONFIG_FILE=./config.json
CLOUDOPS_MODE=aws
CLOUDOPS_BIND_ADDRESS=127.0.0.1
CLOUDOPS_PORT=8082
COMPOSE_PROJECT_NAME=cloudops-local
# Linux / macOS。Windows では区切りを ; に変更する。
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
# Linux / macOS。Windows ではこの行を削除すると USERPROFILE が使われる。
AWS_CONFIG_DIR=${HOME}/.aws
CLOUDOPS_TRUSTED_PROXIES=
