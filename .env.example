# EC2 用。config.example.json を config.json にコピーし、環境に合わせて設定する。
AWS_REGION=ap-northeast-1
CLOUDOPS_CONFIG_FILE=./config.json
CLOUDOPS_MODE=aws
# ALB から受ける場合は 0.0.0.0 に変更し、セキュリティグループで接続元を制限する。
CLOUDOPS_BIND_ADDRESS=127.0.0.1
CLOUDOPS_PORT=8080
# ALB を使う場合のみ、接続元の VPC / サブネットの CIDR を指定する。
CLOUDOPS_TRUSTED_PROXIES=
